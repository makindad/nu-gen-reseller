# Public URL of this landing page (used for canonical URL and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-landing-domain.co.uk

# ── Form delivery: choose ONE ─────────────────────────────────────
# Option A — Formspree: paste your form endpoint. The browser posts directly to it.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Option B — built-in Vercel route (/api/reseller-application):
# leave NEXT_PUBLIC_FORM_ENDPOINT unset and set a webhook that receives each
# validated application as JSON (Zapier, Make, n8n, a CRM, Slack workflow…).
# Without this, production submissions return an error so leads are never silently lost.
# RESELLER_WEBHOOK_URL=https://hooks.example.com/your-webhook
